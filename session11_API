import requests
import logging
import pytest

# -------------------------------
# Logging Configuration
# -------------------------------
# Default: INFO level (will later be changed to WARNING/ERROR for Task 4)
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)
logger = logging.getLogger(__name__)

# -------------------------------
# Task 1: Allure Reporting
# -------------------------------
# Install allure-pytest plugin:
#   pip install allure-pytest
# Run tests with:
#   pytest --alluredir=reports/
# Generate HTML report:
#   allure serve reports/

@pytest.mark.allure_label("orders")
def test_create_order():
    url = "https://jsonplaceholder.typicode.com/posts"
    payload = {"title": "Food Order", "body": "Burger x2"}
    logger.info(f"Sending POST request to {url} with payload {payload}")
    response = requests.post(url, json=payload)
    logger.info(f"Response status: {response.status_code}")
    assert response.status_code == 201


# -------------------------------
# Task 2: Logging Requests/Responses
# -------------------------------
def test_get_order():
    url = "https://jsonplaceholder.typicode.com/posts/1"
    logger.info(f"Sending GET request to {url}")
    response = requests.get(url)
    logger.info(f"Response body: {response.text}")
    assert response.status_code == 200


