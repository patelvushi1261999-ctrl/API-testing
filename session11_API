# Task 4: Adjust Logging Level
# -------------------------------
def test_trigger_failure():
    # Change logging level to WARNING/ERROR only
    logger.setLevel(logging.WARNING)

    url = "https://jsonplaceholder.typicode.com/invalidendpoint"
    logger.info(f"Sending GET request to {url}")  # This won't show now
    response = requests.get(url)

    if response.status_code != 200:
        logger.error(f"Test failed! Status: {response.status_code}")
    assert response.status_code == 200  # This will fail intentionally
