// 5. Python Requests - Music Streaming App (Spotify-style)
// ===============================
import requests

base_url = "https://mock-music-api.com"

# Step 1: Login
resp = requests.post(f"{base_url}/login", json={"username":"vrushi","password":"pass123"})
token = resp.json()["token"]

headers = {"Authorization": f"Bearer {token}"}

# Step 2: Fetch playlists
resp2 = requests.get(f"{base_url}/playlists", headers=headers)
playlist_id = resp2.json()[0]["id"]

# Step 3: Add song to playlist
resp3 = requests.post(f"{base_url}/playlists/{playlist_id}/songs", headers=headers, json={
    "songId": "song789"
})
print(resp3.json())

