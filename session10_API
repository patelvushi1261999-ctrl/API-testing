// ===============================
// 2. REST Assured (Java) - Flipkart-style purchase
// ===============================
import io.restassured.RestAssured;
import io.restassured.response.Response;
import static io.restassured.RestAssured.*;

public class FlipkartFlow {
    public static void main(String[] args) {
        RestAssured.baseURI = "https://mock-flipkart-api.com";

        // Step 1: Add product to cart
        Response addCart = given()
            .header("Content-Type", "application/json")
            .body("{\"productId\":\"p123\",\"quantity\":1}")
        .when()
            .post("/cart")
        .then().extract().response();

        String cartId = addCart.jsonPath().getString("cartId");

        // Step 2: Update cart quantity
        given()
            .header("Content-Type", "application/json")
            .body("{\"cartId\":\"" + cartId + "\",\"quantity\":2}")
        .when()
            .put("/cart/update")
        .then().statusCode(200);

        // Step 3: Place order
        given()
            .header("Content-Type", "application/json")
            .body("{\"cartId\":\"" + cartId + "\"}")
        .when()
            .post("/order")
        .then().statusCode(201);
    }
}


