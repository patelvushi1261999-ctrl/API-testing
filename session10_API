// 3. Python Requests - BookMyShow flow
// ===============================
import requests

base_url = "https://mock-bookmyshow-api.com"

# Step 1: Search movie
resp = requests.get(f"{base_url}/movies?name=Inception")
movie_id = resp.json()[0]["id"]

# Step 2: Select seats
resp2 = requests.post(f"{base_url}/seats", json={
    "movieId": movie_id,
    "seats": ["A1", "A2"]
})
booking_id = resp2.json()["bookingId"]

# Step 3: Confirm booking
resp3 = requests.post(f"{base_url}/confirm", json={
    "bookingId": booking_id
})
print(resp3.json())


