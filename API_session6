import requests
import time

# -------------------------------
# Task 1: GET /posts/1
# -------------------------------
def task1_get_post():
    print("\n--- Task 1 ---")
    url = "https://jsonplaceholder.typicode.com/posts/1"
    response = requests.get(url)
    assert response.status_code == 200, "Status code is not 200"
    print("Status Code:", response.status_code)


# -------------------------------
# Task 2: GET /users/3
# -------------------------------
def task2_get_user3():
    print("\n--- Task 2 ---")
    url = "https://jsonplaceholder.typicode.com/users/3"
    response = requests.get(url)
    data = response.json()
    assert "username" in data, "Missing 'username' field"
    assert isinstance(data["username"], str), "'username' is not a string"
    assert "address" in data, "Missing 'address' field"
    assert isinstance(data["address"], dict), "'address' is not an object"
    print("Username:", data["username"])
    print("Address:", data["address"])


# -------------------------------
# Task 3: GET /comments/5
# -------------------------------
def task3_get_comment5():
    print("\n--- Task 3 ---")
    url = "https://jsonplaceholder.typicode.com/comments/5"
    response = requests.get(url)
    content_type = response.headers.get("Content-Type")
    assert content_type == "application/json; charset=utf-8", f"Unexpected Content-Type: {content_type}"
    print("Content-Type header:", content_type)


# -------------------------------
# Task 4: GET /albums (response time)
# -------------------------------
def task4_get_albums_response_time():
    print("\n--- Task 4 ---")
    url = "https://jsonplaceholder.typicode.com/albums"
    start = time.time()
    response = requests.get(url)
    end = time.time()
    elapsed_ms = (end - start) * 1000
    assert elapsed_ms < 1200, f"Response time too high: {elapsed_ms:.2f} ms"
    print(f"Response time: {elapsed_ms:.2f} ms")


