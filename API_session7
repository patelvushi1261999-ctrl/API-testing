import requests

# -------------------------------
# Task 1: CoinGecko Bitcoin Price
# -------------------------------
def task1_coingecko_price():
    print("\n--- Task 1 ---")
    url = "https://api.coingecko.com/api/v3/simple/price"
    headers = {
        "x-cg-api-key": "YOUR_API_KEY"   # Replace with your actual CoinGecko API key
    }
    params = {
        "ids": "bitcoin",
        "vs_currencies": "inr"
    }
    response = requests.get(url, headers=headers, params=params)
    data = response.json()
    print("Bitcoin Price in INR:", data.get("bitcoin", {}).get("inr"))


# -------------------------------
# Task 2: Spotify Profile
# -------------------------------
def task2_spotify_profile():
    print("\n--- Task 2 ---")
    token = "YOUR_SPOTIFY_BEARER_TOKEN"  # Replace with your actual token
    url = "https://api.spotify.com/v1/me"
    headers = {
        "Authorization": f"Bearer {token}"
    }
    response = requests.get(url, headers=headers)
    if response.status_code == 200:
        print("Spotify Profile:", response.json())
    else:
        print("Error:", response.status_code, response.text)


# -------------------------------
# Task 3: Zomato-style Favorites
# -------------------------------
def task3_zomato_favorites():
    print("\n--- Task 3 ---")
    url = "https://mock-zomato-api.com/user/favorites"

    # Case 1: No API key
    response_no_key = requests.get(url)
    print("No Key Response:", response_no_key.status_code, response_no_key.text)

    # Case 2: Invalid API key
    headers_invalid = {"x-api-key": "INVALID_KEY"}
    response_invalid = requests.get(url, headers=headers_invalid)
    print("Invalid Key Response:", response_invalid.status_code, response_invalid.text)

    # Case 3: Valid API key
    headers_valid = {"x-api-key": "VALID_KEY"}  # Replace with actual valid key
    response_valid = requests.get(url, headers=headers_valid)
    print("Valid Key Response:", response_valid.status_code, response_valid.text)


