# 5. AI-Generated Test - BookMyShow Sold-Out Show
# ===============================================
import requests

def test_sold_out_booking():
    base_url = "https://mock-bookmyshow-api.com"
    movie_id = "inception123"
    show_id = "show789"  # sold-out show

    resp = requests.post(f"{base_url}/book", json={
        "movieId": movie_id,
        "showId": show_id,
        "seats": ["A1"]
    })

    assert resp.status_code == 400
    assert resp.json()["error"] == "Show is sold out"

# Learned: Copilot suggested checking both status code and error message.
# This reinforced that good API tests validate not just codes but also
# the response body content for meaningful errors.

