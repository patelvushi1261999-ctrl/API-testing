// 2. REST Assured (Java) - Flipkart Product Search
// ===============================================
import io.restassured.RestAssured;
import static io.restassured.RestAssured.*;
import static org.hamcrest.Matchers.*;
import org.testng.annotations.Test;

public class ApiTests {

    @Test
    public void testSearchWithResults() {
        RestAssured.baseURI = "https://mock-flipkart-api.com";
        given()
            .queryParam("keyword", "laptop")
        .when()
            .get("/products/search")
        .then()
            .statusCode(200)
            .body("products.size()", greaterThan(0));
    }

    @Test
    public void testSearchNoResults() {
        RestAssured.baseURI = "https://mock-flipkart-api.com";
        given()
            .queryParam("keyword", "xyznotfound")
        .when()
            .get("/products/search")
        .then()
            .statusCode(200)
            .body("products.size()", equalTo(0));
    }

    // ===============================================
    // 3. Authentication Test - Paytm-like App
    // ===============================================
    @Test
    public void testInvalidLogin() {
        RestAssured.baseURI = "https://mock-paytm-api.com";
        given()
            .header("Content-Type", "application/json")
            .body("{\"username\":\"wrong\",\"password\":\"badpass\"}")
        .when()
            .post("/auth/login")
        .then()
            .statusCode(401)
            .body("error", equalTo("Invalid credentials"));
    }

    // ===============================================
    // 4. Refactor Common Setup
    // ===============================================
    // Instead of repeating baseURI and headers, extract them:
    @BeforeClass
    public void setup() {
        RestAssured.baseURI = "https://mock-api.com";
        RestAssured.requestSpecification = given()
            .header("Content-Type", "application/json");
    }



